{{- define "head" -}}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="/static/favicon.png?r={{ .Config.StaticDirRevision }}" type="image/png" />
<link rel="stylesheet" href="/static/colors.css?r={{ .Config.StaticDirRevision }}" />
<link rel="stylesheet" href="/static/global.css?r={{ .Config.StaticDirRevision }}" />
<noscript>
	<link rel="stylesheet" href="/static/noscript.css?r={{ .Config.StaticDirRevision }}" />
</noscript>
{{- end }}
